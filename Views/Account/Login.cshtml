@model MenuMint.ViewModels.LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Log in";
    ViewData["ArtTitle"] = "Welcome back, chef.";
    ViewData["ArtText"] = "Your menu is waiting. Update a price, mark a dish sold out, and your QR code is already up to date.";
}

<div data-reveal>
    <h1 class="h2 mb-1">Log in</h1>
    <p class="text-muted-mm mb-4">Manage your restaurant menu.</p>

    @if (TempData["Success"] is string ok)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 rounded-4 border-0" style="background:var(--mm-mint-100);color:var(--mm-mint-700)">
            <i class="bi bi-check-circle-fill"></i> @ok
        </div>
    }

    <form asp-action="Login" method="post" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="mm-alert-error"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <div class="input-icon">
                <i class="bi bi-envelope"></i>
                <input asp-for="Email" class="form-control" placeholder="you@restaurant.com" autocomplete="email" />
            </div>
            <span asp-validation-for="Email" class="mm-field-error"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label">Password</label>
            <div class="input-icon">
                <i class="bi bi-lock"></i>
                <input asp-for="Password" class="form-control" placeholder="Your password" autocomplete="current-password" />
                <button type="button" class="pw-toggle" data-toggle-password aria-label="Show password"><i class="bi bi-eye"></i></button>
            </div>
            <span asp-validation-for="Password" class="mm-field-error"></span>
        </div>

        <div class="form-check mb-4">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label">Remember me</label>
        </div>

        <button type="submit" class="btn btn-mint w-100 btn-lg">Log in</button>
    </form>

    <p class="text-center text-muted-mm mt-4 mb-0">
        New to MenuMint? <a asp-action="Register" class="fw-bold">Create an account</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
