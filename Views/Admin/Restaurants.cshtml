@model List<MenuMint.ViewModels.AdminRowVm>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Restaurants";
}

<div class="page-head" data-reveal>
    <p class="page-lead">Search and manage accounts. <strong>Deactivated menus go offline immediately.</strong></p>
</div>

<div class="toolbar" data-reveal>
    <div class="search-box">
        <i class="bi bi-search"></i>
        <input id="rSearch" class="form-control" placeholder="Search by restaurant, owner or email…" autocomplete="off" />
    </div>
    <div class="chip-scroll" id="rStatus">
        <button type="button" class="chip active" data-status="all">All <small>@Model.Count</small></button>
        <button type="button" class="chip" data-status="1">Active <small>@Model.Count(r => r.IsActive)</small></button>
        <button type="button" class="chip" data-status="0">Deactivated <small>@Model.Count(r => !r.IsActive)</small></button>
    </div>
</div>

<div class="mm-card p-0 overflow-hidden" data-reveal>
    <div class="table-wrap">
        <table class="mm-table">
            <thead>
                <tr>
                    <th>Restaurant</th>
                    <th>Owner</th>
                    <th>Menu</th>
                    <th>Joined</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody id="rBody">
                @foreach (var r in Model)
                {
                    <tr data-search="@((r.Name + " " + r.OwnerName + " " + r.OwnerEmail).ToLower())" data-status="@(r.IsActive ? "1" : "0")">
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div class="r-avatar">@r.Name[0]</div>
                                <div class="min-w-0">
                                    <div class="fw-bold text-truncate">@r.Name</div>
                                    <div class="small text-muted-mm text-truncate">/m/@r.Slug</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="fw-semibold">@r.OwnerName</div>
                            <div class="small text-muted-mm">@r.OwnerEmail</div>
                        </td>
                        <td>
                            <div class="fw-semibold">@r.Items items</div>
                            <div class="small text-muted-mm">@r.Categories categories</div>
                        </td>
                        <td class="text-nowrap">@r.Joined.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (r.IsActive)
                            {
                                <span class="badge-soft">Active</span>
                            }
                            else
                            {

                                <span class="badge-off">Deactivated</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex justify-content-end gap-1">
                                @if (r.IsMain && r.IsActive)
                                {
                                    <a class="icon-btn" href="/m/@r.Slug" target="_blank" title="View public menu"><i class="bi bi-box-arrow-up-right"></i></a>
                                }
                                else
                                {
                                    <span class="icon-btn" style="opacity:.35;cursor:not-allowed" title="@(r.IsMain ? "Menu is offline" : "Sample restaurant (no public menu in the demo)")"><i class="bi bi-box-arrow-up-right"></i></span>
                                }
                                <button type="button" class="btn btn-sm @(r.IsActive ? "btn-ghost" : "btn-soft")"
                                        data-toggle data-id="@r.Id" data-name="@r.Name" data-active="@(r.IsActive ? "1" : "0")">
                                    @if (r.IsActive)
                                    {
                                        <text><i class="bi bi-pause-circle me-1"></i>Deactivate</text>
                                    }
                                    else
                                    {

                                        <text><i class="bi bi-play-circle me-1"></i>Activate</text>
                                    }
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="empty-state d-none" id="rEmpty" style="padding:2.5rem 1rem">
        <div class="empty-emoji">🔍</div>
        <h5>No restaurants match</h5>
        <p class="text-muted-mm mb-0">Try a different search or status.</p>
    </div>
</div>

<!-- Confirm modal -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content text-center p-3">
            <form asp-action="Toggle" method="post">
                <input type="hidden" name="id" id="cmId" />
                <div class="display-5 mb-1" id="cmIcon">⏸️</div>
                <h5 class="mb-1" id="cmTitle">Deactivate?</h5>
                <p class="text-muted-mm mb-3" id="cmText"></p>
                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-mint" id="cmBtn">Confirm</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const rows = [...document.querySelectorAll('#rBody tr')];
            const search = document.getElementById('rSearch');
            const empty = document.getElementById('rEmpty');
            let status = 'all', q = '';

            function apply() {
                let shown = 0;
                rows.forEach(r => {
                    const ok = (status === 'all' || r.dataset.status === status) && r.dataset.search.includes(q);
                    r.classList.toggle('d-none', !ok);
                    if (ok) shown++;
                });
                empty.classList.toggle('d-none', shown !== 0);
            }

            search.addEventListener('input', () => { q = search.value.trim().toLowerCase(); apply(); });
            document.getElementById('rStatus').addEventListener('click', e => {
                const b = e.target.closest('.chip'); if (!b) return;
                document.querySelectorAll('#rStatus .chip').forEach(x => x.classList.remove('active'));
                b.classList.add('active');
                status = b.dataset.status; apply();
            });

            const modal = new bootstrap.Modal(document.getElementById('confirmModal'));
            document.querySelectorAll('[data-toggle]').forEach(b => b.addEventListener('click', () => {
                const active = b.dataset.active === '1';
                document.getElementById('cmId').value = b.dataset.id;
                document.getElementById('cmIcon').textContent = active ? '⏸️' : '▶️';
                document.getElementById('cmTitle').textContent = active ? 'Deactivate restaurant?' : 'Activate restaurant?';
                document.getElementById('cmText').innerHTML = active
                    ? `<strong>${b.dataset.name}</strong>'s public menu will go offline right away.`
                    : `<strong>${b.dataset.name}</strong>'s public menu will be visible to guests again.`;
                document.getElementById('cmBtn').textContent = active ? 'Deactivate' : 'Activate';
                document.getElementById('cmBtn').className = 'btn ' + (active ? 'btn-danger' : 'btn-mint');
                modal.show();
            }));
        })();
    </script>
}