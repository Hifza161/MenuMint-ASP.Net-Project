@using MenuMint.ViewModels
@model List<MenuMint.ViewModels.CategoryRowVm>
@{
    Layout = "_OwnerLayout";
    ViewData["Title"] = "Categories";
}

<div class="page-head" data-reveal>
    <p class="page-lead">Guests see your categories in this order. <strong>Reorder, rename or hide</strong> them anytime.</p>
    <button type="button" class="btn btn-mint" data-add><i class="bi bi-plus-lg me-1"></i> Add category</button>
</div>

@if (!Model.Any())
{
    <div class="mm-card empty-state" data-reveal>
        <div class="empty-emoji">🗂️</div>
        <h4>No categories yet</h4>
        <p class="text-muted-mm">Start with something like Starters, Main Course, Desserts or Beverages.</p>
        <div class="d-flex flex-wrap gap-2 justify-content-center">
            <button type="button" class="btn btn-mint" data-add><i class="bi bi-plus-lg me-1"></i> Create your first category</button>
            <form asp-action="LoadSample" method="post" class="m-0">
                <button type="submit" class="btn btn-soft"><i class="bi bi-magic me-1"></i> Load a sample menu</button>
            </form>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @for (int i = 0; i < Model.Count; i++)
        {
            @await Html.PartialAsync("_CategoryCard", new CategoryCardVm(Model[i], i + 1, Model.Count))
        }
    </div>
}

<!-- ===== Add / Edit modal ===== -->
<div class="modal fade" id="catModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="SaveCategory" method="post" id="catForm" novalidate>
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title" id="catModalTitle">Add category</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="CategoryId" id="catId" value="0" />
                    <label class="form-label" for="catName">Category name</label>
                    <input class="form-control" name="Name" id="catName" maxlength="50" minlength="2" required placeholder="e.g. Desserts" autocomplete="off" />
                    <div class="invalid-feedback">Please enter a name (2 to 50 characters).</div>

                    <div class="small text-muted-mm mt-3 mb-2">Quick picks</div>
                    <div class="quick-picks">
                        <button type="button" class="chip" data-pick="Starters">Starters</button>
                        <button type="button" class="chip" data-pick="Main Course">Main Course</button>
                        <button type="button" class="chip" data-pick="Desserts">Desserts</button>
                        <button type="button" class="chip" data-pick="Beverages">Beverages</button>
                        <button type="button" class="chip" data-pick="Sides">Sides</button>
                        <button type="button" class="chip" data-pick="Specials">Specials</button>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-mint" id="catSubmit">Add category</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ===== Delete modal ===== -->
<div class="modal fade" id="delModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content text-center p-3">
            <form asp-action="DeleteCategory" method="post">
                <input type="hidden" name="id" id="delId" />
                <div class="display-5 mb-1">🗑️</div>
                <h5 class="mb-1">Delete category?</h5>
                <p class="text-muted-mm mb-2">You're about to delete <strong id="delName"></strong>.</p>
                <p class="small text-danger fw-bold d-none" id="delWarn"></p>
                <div class="d-flex gap-2 justify-content-center mt-3">
                    <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger" id="delConfirm">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const catModal = new bootstrap.Modal(document.getElementById('catModal'));
            const delModal = new bootstrap.Modal(document.getElementById('delModal'));
            const form = document.getElementById('catForm');
            const idInput = document.getElementById('catId');
            const nameInput = document.getElementById('catName');
            const title = document.getElementById('catModalTitle');
            const submit = document.getElementById('catSubmit');

            function openCat(id, name) {
                form.classList.remove('was-validated');
                idInput.value = id;
                nameInput.value = name;
                title.textContent = id ? 'Rename category' : 'Add category';
                submit.textContent = id ? 'Save changes' : 'Add category';
                catModal.show();
            }
            document.getElementById('catModal').addEventListener('shown.bs.modal', () => nameInput.focus());

            document.querySelectorAll('[data-add]').forEach(b => b.addEventListener('click', () => openCat(0, '')));
            document.querySelectorAll('[data-edit]').forEach(b =>
                b.addEventListener('click', () => openCat(b.dataset.id, b.dataset.name)));
            document.querySelectorAll('[data-pick]').forEach(b =>
                b.addEventListener('click', () => { nameInput.value = b.dataset.pick; nameInput.focus(); }));

            form.addEventListener('submit', e => {
                nameInput.value = nameInput.value.trim();
                if (!form.checkValidity()) {
                    e.preventDefault();
                    form.classList.add('was-validated');
                }
            });

            // Delete flow
            const warn = document.getElementById('delWarn');
            const confirmBtn = document.getElementById('delConfirm');
            document.querySelectorAll('[data-delete]').forEach(b => b.addEventListener('click', () => {
                const count = +b.dataset.count;
                document.getElementById('delId').value = b.dataset.id;
                document.getElementById('delName').textContent = b.dataset.name;
                if (count > 0) {
                    warn.textContent = `It still has ${count} item${count === 1 ? '' : 's'}. Move or delete them first.`;
                    warn.classList.remove('d-none');
                    confirmBtn.disabled = true;
                } else {
                    warn.classList.add('d-none');
                    confirmBtn.disabled = false;
                }
                delModal.show();
            }));
        })();
    </script>
}