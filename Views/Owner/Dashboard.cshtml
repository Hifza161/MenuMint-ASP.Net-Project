@model MenuMint.ViewModels.DashboardViewModel
@{
    Layout = "_OwnerLayout";
    ViewData["Title"] = "Dashboard";
    var liveUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/m/{Model.Slug}";
    var firstName = Model.OwnerName.Split(' ')[0];
}

<!-- Greeting -->
<div class="mb-4" data-reveal>
    <h2 class="h3 mb-1">Hello, @firstName 👋</h2>
    <p class="text-muted-mm mb-0">Here's how <strong>@Model.RestaurantName</strong> is doing today.</p>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3" data-reveal>
        <div class="mm-card stat-card">
            <div class="stat-icon"><i class="bi bi-tags"></i></div>
            <div class="stat-num" data-count="@Model.CategoryCount">0</div>
            <div class="stat-label">Categories</div>
        </div>
    </div>
    <div class="col-6 col-xl-3" data-reveal data-reveal-delay="1">
        <div class="mm-card stat-card">
            <div class="stat-icon coral"><i class="bi bi-egg-fried"></i></div>
            <div class="stat-num" data-count="@Model.ItemCount">0</div>
            <div class="stat-label">Menu items</div>
        </div>
    </div>
    <div class="col-6 col-xl-3" data-reveal data-reveal-delay="2">
        <div class="mm-card stat-card">
            <div class="stat-icon"><i class="bi bi-check2-circle"></i></div>
            <div class="stat-num" data-count="@Model.AvailableCount">0</div>
            <div class="stat-label">Available</div>
        </div>
    </div>
    <div class="col-6 col-xl-3" data-reveal data-reveal-delay="3">
        <div class="mm-card stat-card">
            <div class="stat-icon butter"><i class="bi bi-slash-circle"></i></div>
            <div class="stat-num" data-count="@Model.SoldOutCount">0</div>
            <div class="stat-label">Sold out</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- LEFT COLUMN -->
    <div class="col-xl-8">

        <!-- Live link -->
        <div class="live-card mb-4" data-reveal>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="live-dot"></span>
                <strong>Your menu is live</strong>
            </div>
            <p class="opacity-75 mb-3">Share this link or print the QR code. Updates appear instantly.</p>
            <div class="live-link">
                <i class="bi bi-link-45deg"></i>
                <input type="text" id="liveUrl" value="@liveUrl" readonly />
                <button type="button" class="btn btn-light btn-sm" id="copyLive"><i class="bi bi-clipboard"></i> Copy</button>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <a class="btn btn-light btn-sm" href="/m/@Model.Slug" target="_blank"><i class="bi bi-eye"></i> Open menu</a>
                <a class="btn btn-sm live-outline" href="/Owner/Qr"><i class="bi bi-qr-code"></i> Get QR code</a>
            </div>
        </div>

        <!-- Quick actions -->
        <div class="row g-3 mb-4">
            <div class="col-md-4" data-reveal>
                <a href="/Owner/Categories" class="mm-card quick-card hover-lift">
                    <i class="bi bi-plus-circle"></i><strong>Add category</strong><span>Starters, Mains…</span>
                </a>
            </div>
            <div class="col-md-4" data-reveal data-reveal-delay="1">
                <a href="/Owner/Items" class="mm-card quick-card hover-lift">
                    <i class="bi bi-plus-square"></i><strong>Add menu item</strong><span>Dish, price, photo</span>
                </a>
            </div>
            <div class="col-md-4" data-reveal data-reveal-delay="2">
                <a href="/Owner/Qr" class="mm-card quick-card hover-lift">
                    <i class="bi bi-qr-code"></i><strong>Download QR</strong><span>Print for your tables</span>
                </a>
            </div>
        </div>

        <!-- Recent items -->
        <div class="mm-card p-4" data-reveal>
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h5 class="m-0">Recent items</h5>
                <a href="/Owner/Items" class="small fw-bold">View all</a>
            </div>
            @foreach (var it in Model.RecentItems)
            {
                <div class="recent-row">
                    <div class="thumb">
                        @if (!string.IsNullOrEmpty(it.ImagePath))
                        {
                            <img src="@it.ImagePath" alt="" loading="lazy" />
                        }
                        else
                        {
                            <text>@it.Emoji</text>
                        }
                    </div>
                    <div class="flex-grow-1">
                        <div class="fw-bold">@it.Name</div>
                        <div class="small text-muted-mm">@it.Category</div>
                    </div>
                    <div class="fw-bold text-mint">Rs. @it.Price.ToString("N0")</div>
                    @if (it.IsAvailable)
                    {
                        <span class="badge-soft">Available</span>
                    }
                    else
                    {
                        <span class="badge-off">Sold out</span>
                    }
                </div>
            }
        </div>
    </div>

    <!-- RIGHT COLUMN -->
    <div class="col-xl-4">
        <div class="mm-card p-4" data-reveal>
            <h5 class="mb-3">Setup progress</h5>
            <div class="ring-wrap">
                <div class="ring" data-percent="@Model.ProgressPercent" style="--p:0">
                    <span class="ring-num">@Model.ProgressPercent%</span>
                </div>
            </div>
            <ul class="checklist mt-3">
                <li class="@(Model.HasProfile ? "done" : "")"><i class="bi @(Model.HasProfile ? "bi-check-circle-fill" : "bi-circle")"></i> Complete restaurant profile</li>
                <li class="@(Model.CategoryCount > 0 ? "done" : "")"><i class="bi @(Model.CategoryCount > 0 ? "bi-check-circle-fill" : "bi-circle")"></i> Create a category</li>
                <li class="@(Model.ItemCount > 0 ? "done" : "")"><i class="bi @(Model.ItemCount > 0 ? "bi-check-circle-fill" : "bi-circle")"></i> Add your first dish</li>
                <li class="@(Model.HasQr ? "done" : "")"><i class="bi @(Model.HasQr ? "bi-check-circle-fill" : "bi-circle")"></i> Generate your QR code</li>
            </ul>
        </div>
    </div>
</div>