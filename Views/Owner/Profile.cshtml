@using MenuMint.ViewModels
@model ProfileFormViewModel
@{
    Layout = "_OwnerLayout";
    ViewData["Title"] = "Restaurant profile";
    var slug = ViewData["Slug"] as string ?? "";

    string? Err(string key) => ViewData.ModelState[key]?.Errors.FirstOrDefault()?.ErrorMessage;

    var coverUploader = new ImageUploaderVm
    {
        Name = "CoverFile",
        RemoveName = "RemoveCover",
        Label = "Cover photo",
        Note = "(optional, shown at the top of your menu)",
        Prompt = "Click or drag a wide photo here",
        Hint = "Best at 16:9 · JPG, PNG or WEBP · max 3 MB",
        Icon = "bi-image",
        MaxMb = 3,
        ExistingPath = Model.ExistingCoverPath,
        Error = Err("CoverFile")
    };
    var logoUploader = new ImageUploaderVm
    {
        Name = "LogoFile",
        RemoveName = "RemoveLogo",
        Label = "Logo",
        Note = "(optional)",
        Prompt = "Click or drag your logo here",
        Hint = "JPG, PNG or WEBP · max 2 MB",
        MaxMb = 2,
        Fit = "contain",
        ExistingPath = Model.ExistingLogoPath,
        Error = Err("LogoFile")
    };
}

<form asp-action="Profile" method="post" enctype="multipart/form-data" novalidate>
    <div asp-validation-summary="ModelOnly" class="mm-alert-error"></div>

    <div class="form-grid">
        <div class="mm-card p-4" data-reveal>
            <h2 class="h5 mb-1">About your restaurant</h2>
            <p class="text-muted-mm mb-4">Guests see this at the top of your public menu.</p>

            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" maxlength="100" autocomplete="off" />
                    <span asp-validation-for="Name" class="mm-field-error"></span>
                </div>

                <div class="col-12">
                    <label class="form-label">Public menu link</label>
                    <div class="slug-preview">
                        <i class="bi bi-lock-fill"></i>
                        <code>/m/@slug</code>
                        <small class="ms-auto">Permanent, so printed QR codes keep working</small>
                    </div>
                </div>

                <div class="col-12">
                    <div class="d-flex justify-content-between">
                        <label asp-for="Description" class="form-label"></label>
                        <small class="text-muted-mm" id="descCount">0/300</small>
                    </div>
                    <textarea asp-for="Description" class="form-control" rows="3" maxlength="300" placeholder="Tell guests what makes your place special…"></textarea>
                    <span asp-validation-for="Description" class="mm-field-error"></span>
                </div>

                <div class="col-md-7">
                    <label asp-for="Address" class="form-label"></label>
                    <div class="input-icon">
                        <i class="bi bi-geo-alt"></i>
                        <input asp-for="Address" class="form-control" placeholder="Street, area, city" maxlength="200" />
                    </div>
                    <span asp-validation-for="Address" class="mm-field-error"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="Phone" class="form-label"></label>
                    <div class="input-icon">
                        <i class="bi bi-telephone"></i>
                        <input asp-for="Phone" class="form-control" placeholder="0300 1234567" inputmode="tel" />
                    </div>
                    <span asp-validation-for="Phone" class="mm-field-error"></span>
                </div>

                <div class="col-12">@await Html.PartialAsync("_ImageUploader", coverUploader)</div>
                <div class="col-12">@await Html.PartialAsync("_ImageUploader", logoUploader)</div>
            </div>

            <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                <button type="submit" class="btn btn-mint"><i class="bi bi-check2-circle me-1"></i> Save profile</button>
            </div>
        </div>

        <aside class="preview-sticky" data-reveal data-reveal-delay="1">
            <div class="small fw-bold text-muted-mm mb-2 text-uppercase" style="letter-spacing:.1em">Live preview</div>
            <div class="rp-card">
                <div class="rp-head" id="pvHead">
                    <div class="rp-logo"><img id="pvLogo" class="d-none" alt="" /><span id="pvInitial">S</span></div>
                    <h3 class="rp-name" id="pvName">Restaurant</h3>
                    <p class="rp-desc" id="pvDesc"></p>
                    <div class="rp-meta">
                        <span id="pvAddrWrap" class="d-none"><i class="bi bi-geo-alt-fill"></i> <span id="pvAddr"></span></span>
                        <span id="pvPhoneWrap" class="d-none"><i class="bi bi-telephone-fill"></i> <span id="pvPhone"></span></span>
                    </div>
                </div>
                <div class="rp-body">
                    <div class="chip-row" style="padding:0 0 .6rem"><span class="chip active">All</span><span class="chip">Starters</span><span class="chip">Mains</span></div>
                    <div class="dish"><div class="thumb">🍽️</div><div><div class="dish-name">Your dishes appear here</div><div class="dish-desc">Names, prices and photos</div></div></div>
                </div>
            </div>
            <p class="small text-muted-mm mt-2">The top of your public menu page.</p>
        </aside>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/uploader.js" asp-append-version="true"></script>
    <script>
        (function () {
            const $ = id => document.getElementById(id);
            const nameI = $('Name'), descI = $('Description'), addrI = $('Address'), phoneI = $('Phone'), head = $('pvHead');
            let logoSrc  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExistingLogoPath ?? ""));
            let coverSrc = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExistingCoverPath ?? ""));

            function render() {
                const name = nameI.value.trim() || 'Restaurant';
                $('pvName').textContent = name;
                $('pvInitial').textContent = name[0].toUpperCase();
                $('pvDesc').textContent = descI.value.trim() || 'Your description appears here.';
                $('descCount').textContent = descI.value.length + '/300';
                $('pvAddr').textContent = addrI.value.trim();
                $('pvPhone').textContent = phoneI.value.trim();
                $('pvAddrWrap').classList.toggle('d-none', !addrI.value.trim());
                $('pvPhoneWrap').classList.toggle('d-none', !phoneI.value.trim());

                $('pvLogo').src = logoSrc || '';
                $('pvLogo').classList.toggle('d-none', !logoSrc);
                $('pvInitial').classList.toggle('d-none', !!logoSrc);

                head.style.setProperty('--cover', coverSrc ? 'url("' + coverSrc + '")' : 'none');
                head.classList.toggle('has-cover', !!coverSrc);
            }

            // The shared uploader announces every change, so the preview never needs to know how uploading works
            $('LogoFileUploader').addEventListener('uploader:change',  e => { logoSrc  = e.detail.src; render(); });
            $('CoverFileUploader').addEventListener('uploader:change', e => { coverSrc = e.detail.src; render(); });
            [nameI, descI, addrI, phoneI].forEach(el => el.addEventListener('input', render));

            render();
        })();
    </script>
}